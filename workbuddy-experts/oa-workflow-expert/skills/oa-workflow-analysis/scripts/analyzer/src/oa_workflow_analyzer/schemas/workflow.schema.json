{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oa-workflow-analyzer:schema:workflow:1.0",
  "title": "Offline OA workflow analysis result, version 1.0",
  "description": "Contract for workflow.json returned by analyze_export. Exported content and script text are untrusted data. This schema validates structure, not runtime truth, reference existence, hash contents or summary arithmetic. Structured objects allow optional extension properties; typed maps retain their value contracts. Consumers must ignore unknown properties and preserve unknown raw values. Breaking changes require a new schema_version.",
  "type": "object",
  "required": ["schema_version", "analyzer", "source", "workflows", "table_inventory", "evidence", "scripts", "gaps", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analyzer": {"$ref": "#/$defs/analyzer"},
    "source": {"$ref": "#/$defs/source"},
    "workflows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workflow"}},
    "table_inventory": {"type": "array", "items": {"$ref": "#/$defs/tableInventory"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "scripts": {"type": "array", "items": {"$ref": "#/$defs/script"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "text": {"type": "string"},
    "nonemptyText": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "line": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "flag": {"type": ["boolean", "null"], "description": "null means unknown or unavailable, not false."},
    "nullableText": {"type": ["string", "null"]},
    "strings": {"type": "array", "items": {"type": "string"}},
    "raw": {"type": "object", "description": "Preserved source values; unknown platform enums remain data."},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "evidenceId": {"type": "string", "pattern": "^ev[0-9]{6,}$"},
    "sourceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
    "factual": {
      "type": "object",
      "required": ["source_refs"],
      "properties": {"source_refs": {"$ref": "#/$defs/sourceRefs"}, "raw": {"$ref": "#/$defs/raw"}}
    },
    "analyzer": {
      "type": "object",
      "required": ["name", "version", "profile", "language", "runtime_verified", "profile_scope"],
      "properties": {
        "name": {"const": "oa-workflow-analyzer"},
        "version": {"$ref": "#/$defs/nonemptyText"},
        "profile": {"$ref": "#/$defs/nonemptyText"},
        "language": {"$ref": "#/$defs/text"},
        "runtime_verified": {"const": false},
        "profile_scope": {"$ref": "#/$defs/nonemptyText"}
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "sha256", "size_bytes", "xml_sha256", "encoding", "archive_entries"],
      "properties": {
        "name": {"$ref": "#/$defs/nonemptyText"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/count"},
        "xml_sha256": {"$ref": "#/$defs/sha256"},
        "encoding": {"$ref": "#/$defs/nonemptyText"},
        "archive_entries": {"type": "array", "items": {"$ref": "#/$defs/archiveEntry"}}
      }
    },
    "archiveEntry": {
      "type": "object",
      "required": ["name", "size_bytes", "compressed_bytes", "crc", "content_read"],
      "properties": {
        "name": {"$ref": "#/$defs/nonemptyText"},
        "size_bytes": {"$ref": "#/$defs/count"},
        "compressed_bytes": {"$ref": "#/$defs/count"},
        "crc": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "content_read": {"type": "boolean"}
      }
    },
    "workflow": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object",
      "required": ["id", "name", "form_id", "category", "nodes", "links", "fields", "permissions", "detail_permissions", "operator_groups", "options", "formulas", "linkages", "data_inputs", "actions", "layouts", "code_rules", "withdrawal", "issues"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/text"},
        "form_id": {"$ref": "#/$defs/text"},
        "category": {"$ref": "#/$defs/text"},
        "category_name": {"$ref": "#/$defs/text"},
        "interpretation_profile": {"$ref": "#/$defs/nonemptyText"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "permissions": {"type": "array", "items": {"$ref": "#/$defs/permission"}},
        "detail_permissions": {"type": "array", "items": {"$ref": "#/$defs/detailPermission"}},
        "operator_groups": {"type": "array", "items": {"$ref": "#/$defs/operatorGroup"}},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "formulas": {"type": "array", "items": {"$ref": "#/$defs/formula"}},
        "linkages": {"type": "array", "items": {"$ref": "#/$defs/linkage"}},
        "data_inputs": {"type": "array", "items": {"$ref": "#/$defs/dataInput"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "layouts": {"type": "array", "items": {"$ref": "#/$defs/layout"}},
        "code_rules": {"type": "array", "items": {"$ref": "#/$defs/codeRule"}},
        "withdrawal": {"type": "array", "items": {"$ref": "#/$defs/identifiedRecord"}},
        "detail_tables": {"type": "array", "items": {"$ref": "#/$defs/detailTable"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "export_state": {
          "type": "object",
          "description": "absent: table omitted; empty: table present without records; present: matching records exist. Empty sections do not imply a negative business rule.",
          "additionalProperties": {"enum": ["absent", "empty", "present"]}
        }
      }
    },
    "node": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object",
      "required": ["id", "name", "type", "type_name", "signature"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"},
        "type": {"$ref": "#/$defs/text"}, "type_name": {"$ref": "#/$defs/text"},
        "base_raw": {"$ref": "#/$defs/raw"},
        "signature": {
          "type": "object", "required": ["required_mode", "operation_types", "runtime_verified"],
          "properties": {"required_mode": {"$ref": "#/$defs/text"}, "operation_types": {"$ref": "#/$defs/strings"}, "runtime_verified": {"const": false}}
        }
      }
    },
    "link": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["id", "from_node", "to_node", "name", "condition", "is_reject"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "from_node": {"$ref": "#/$defs/text"}, "to_node": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/text"}, "condition": {"$ref": "#/$defs/text"}, "is_reject": {"$ref": "#/$defs/flag"}
      }
    },
    "field": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["id", "name", "label", "table", "db_type", "html_type", "browser_type", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"},
        "label_id": {"$ref": "#/$defs/text"}, "table": {"$ref": "#/$defs/text"}, "db_type": {"$ref": "#/$defs/text"},
        "html_type": {"$ref": "#/$defs/text"}, "browser_type": {"$ref": "#/$defs/text"}, "detail": {"type": "boolean"}
      }
    },
    "permission": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["node_id", "field_id", "view", "edit", "mandatory", "manual_edit_prohibited", "base_permission", "layouts"],
      "properties": {
        "node_id": {"$ref": "#/$defs/text"}, "field_id": {"$ref": "#/$defs/text"},
        "view": {"$ref": "#/$defs/flag"}, "edit": {"$ref": "#/$defs/flag"}, "mandatory": {"$ref": "#/$defs/flag"},
        "manual_edit_prohibited": {"$ref": "#/$defs/flag"},
        "base_permission": {"enum": ["missing", "unknown", "invisible", "readonly", "editable", "mandatory"]},
        "layouts": {"type": "array", "items": {"$ref": "#/$defs/permissionLayout"}}
      }
    },
    "permissionLayout": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["id", "layout_id", "surface", "placement", "hidden", "placements"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "layout_id": {"$ref": "#/$defs/text"}, "surface": {"$ref": "#/$defs/text"},
        "placement": {"enum": ["present", "absent", "unknown"]}, "hidden": {"$ref": "#/$defs/strings"},
        "placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}}
      }
    },
    "placement": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["field_id", "table", "cell", "hidden"],
      "properties": {
        "field_id": {"$ref": "#/$defs/text"}, "table": {"$ref": "#/$defs/text"}, "cell": {"$ref": "#/$defs/text"},
        "hidden": {"$ref": "#/$defs/strings"}, "label": {"$ref": "#/$defs/text"}
      }
    },
    "detailPermission": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["node_id", "group_id", "default_rows", "add", "edit", "delete", "copy", "required"],
      "properties": {
        "node_id": {"$ref": "#/$defs/text"}, "group_id": {"$ref": "#/$defs/text"}, "default_rows": {"$ref": "#/$defs/text"},
        "add": {"$ref": "#/$defs/flag"}, "edit": {"$ref": "#/$defs/flag"}, "delete": {"$ref": "#/$defs/flag"},
        "copy": {"$ref": "#/$defs/flag"}, "required": {"$ref": "#/$defs/flag"}
      }
    },
    "operatorGroup": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["id", "node_id", "name", "rules"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "node_id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "rules": {"type": "array", "items": {"$ref": "#/$defs/operatorRule"}}}
    },
    "operatorRule": {
      "allOf": [{"$ref": "#/$defs/factual"}],
      "type": "object", "required": ["id", "type", "kind", "sign_order", "sign_type", "objects", "runtime_members_verified", "hrm_operators"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "type": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"},
        "sign_order": {"$ref": "#/$defs/text"}, "sign_type": {"$ref": "#/$defs/text"}, "runtime_members_verified": {"const": false},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/operatorObject"}},
        "hrm_operators": {"type": "array", "items": {"$ref": "#/$defs/factual"}}
      }
    },
    "operatorObject": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "member_ids": {"$ref": "#/$defs/strings"}, "membership_scope": {"$ref": "#/$defs/text"}, "runtime_members_verified": {"const": false}}
    },
    "option": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "field_id", "value", "label", "default", "cancelled"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "field_id": {"$ref": "#/$defs/text"}, "value": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "default": {"$ref": "#/$defs/flag"}, "cancelled": {"$ref": "#/$defs/flag"}}
    },
    "formula": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "node_id", "layout_id", "expression", "triggers", "table"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "node_id": {"$ref": "#/$defs/text"}, "layout_id": {"$ref": "#/$defs/text"}, "expression": {"$ref": "#/$defs/text"}, "triggers": {"$ref": "#/$defs/text"}, "table": {"$ref": "#/$defs/text"}}
    },
    "linkage": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["node_id", "trigger_field", "trigger_value", "target_fields", "stored_code", "meaning", "runtime_code"],
      "properties": {"node_id": {"$ref": "#/$defs/text"}, "trigger_field": {"$ref": "#/$defs/text"}, "trigger_value": {"$ref": "#/$defs/text"}, "target_fields": {"$ref": "#/$defs/strings"}, "stored_code": {"$ref": "#/$defs/text"}, "meaning": {"$ref": "#/$defs/text"}, "runtime_code": {"type": ["integer", "null"]}}
    },
    "dataInput": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "name", "enabled", "trigger_field", "mappings", "queries"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "enabled": {"$ref": "#/$defs/flag"}, "trigger_field": {"$ref": "#/$defs/text"}, "mappings": {"type": "array", "items": {"$ref": "#/$defs/dataMapping"}}, "queries": {"type": "array", "items": {"$ref": "#/$defs/dataQuery"}}}
    },
    "dataMapping": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "target_field", "source_field", "table_id", "type"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "target_field": {"$ref": "#/$defs/text"}, "source_field": {"$ref": "#/$defs/text"}, "table_id": {"$ref": "#/$defs/text"}, "type": {"$ref": "#/$defs/text"}}
    },
    "dataQuery": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "data_source", "condition", "tables", "mappings"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "data_source": {"$ref": "#/$defs/text"}, "condition": {"$ref": "#/$defs/text"}, "tables": {"type": "array", "items": {"$ref": "#/$defs/namedRecord"}}, "mappings": {"type": "array", "items": {"$ref": "#/$defs/dataMapping"}}}
    },
    "action": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "node_id", "link_id", "type", "external_action_marker", "interface_id"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "node_id": {"$ref": "#/$defs/text"}, "link_id": {"$ref": "#/$defs/text"}, "type": {"$ref": "#/$defs/text"}, "external_action_marker": {"type": "boolean"}, "interface_id": {"$ref": "#/$defs/nullableText"}}
    },
    "layout": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "node_id", "name", "active", "surface", "type", "placements", "placements_known", "tables", "parse_status"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "node_id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"},
        "active": {"$ref": "#/$defs/flag"}, "surface": {"$ref": "#/$defs/text"}, "type": {"$ref": "#/$defs/text"},
        "placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}}, "placements_known": {"type": "boolean"},
        "tables": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["name", "attributes"], "properties": {"name": {"$ref": "#/$defs/text"}, "attributes": {"type": "object"}}}},
        "parse_status": {"enum": ["parsed", "missing", "unsupported"]}
      }
    },
    "identifiedRecord": {"allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/text"}}},
    "namedRecord": {"allOf": [{"$ref": "#/$defs/identifiedRecord"}], "type": "object", "required": ["name"], "properties": {"name": {"$ref": "#/$defs/text"}}},
    "detailTable": {"allOf": [{"$ref": "#/$defs/namedRecord"}], "type": "object", "required": ["order"], "properties": {"order": {"$ref": "#/$defs/text"}}},
    "codeRule": {"allOf": [{"$ref": "#/$defs/identifiedRecord"}], "type": "object", "required": ["table"], "properties": {"table": {"$ref": "#/$defs/text"}}},
    "issue": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["code", "message"],
      "properties": {"code": {"$ref": "#/$defs/nonemptyText"}, "message": {"$ref": "#/$defs/nonemptyText"}}
    },
    "tableInventory": {
      "type": "object", "required": ["element_id", "table", "count", "present", "supported"],
      "properties": {
        "element_id": {"$ref": "#/$defs/text"}, "table": {"$ref": "#/$defs/nonemptyText"}, "count": {"$ref": "#/$defs/count"},
        "present": {"type": "boolean"}, "supported": {"type": "boolean"}, "xml_line": {"$ref": "#/$defs/line"},
        "field_names": {"$ref": "#/$defs/strings"}, "metadata": {"$ref": "#/$defs/stringMap"},
        "nested_table": {"type": "boolean"}, "excluded": {"$ref": "#/$defs/text"}
      }
    },
    "evidence": {
      "type": "object", "required": ["id", "table", "line", "element_id", "parent_ref", "values", "metadata", "decodings"],
      "properties": {
        "id": {"$ref": "#/$defs/evidenceId"}, "table": {"$ref": "#/$defs/nonemptyText"}, "line": {"$ref": "#/$defs/line"},
        "element_id": {"$ref": "#/$defs/text"}, "parent_ref": {"anyOf": [{"$ref": "#/$defs/evidenceId"}, {"type": "null"}]},
        "values": {"$ref": "#/$defs/stringMap"}, "metadata": {"$ref": "#/$defs/stringMap"},
        "decodings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fieldDecoding"}}
      }
    },
    "fieldDecoding": {
      "type": "object", "required": ["raw_text_sha256", "assumption", "status"],
      "properties": {"raw_text_sha256": {"$ref": "#/$defs/sha256"}, "decoded_bytes_sha256": {"$ref": "#/$defs/sha256"}, "assumption": {"$ref": "#/$defs/nonemptyText"}, "status": {"enum": ["decoded", "failed"]}, "encoding": {"$ref": "#/$defs/nonemptyText"}, "error": {"$ref": "#/$defs/text"}}
    },
    "script": {
      "allOf": [{"$ref": "#/$defs/factual"}], "type": "object", "required": ["id", "node_id", "workflow_id", "layout_id", "active", "channels", "decoding", "text", "sanitized_text_sha256", "analysis"],
      "properties": {
        "id": {"type": "string", "pattern": "^script[0-9]{4,}$"}, "node_id": {"$ref": "#/$defs/text"},
        "workflow_id": {"$ref": "#/$defs/text"}, "layout_id": {"$ref": "#/$defs/text"}, "active": {"$ref": "#/$defs/flag"},
        "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonemptyText"}},
        "decoding": {"$ref": "#/$defs/scriptDecoding"}, "text": {"$ref": "#/$defs/text"},
        "sanitized_text_sha256": {"$ref": "#/$defs/sha256"}, "analysis": {"$ref": "#/$defs/scriptAnalysis"}
      }
    },
    "scriptDecoding": {
      "type": "object", "required": ["status", "encoding", "profile", "input_sha256"],
      "properties": {
        "status": {"enum": ["plain", "decoded", "empty", "unsupported"]}, "encoding": {"$ref": "#/$defs/nullableText"},
        "profile": {"$ref": "#/$defs/nullableText"}, "input_sha256": {"$ref": "#/$defs/sha256"},
        "decoded_bytes_sha256": {"$ref": "#/$defs/sha256"}, "text_sha256": {"$ref": "#/$defs/sha256"}, "error": {"$ref": "#/$defs/text"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "unsupported"}}}, "then": {"required": ["error"]}, "else": {"required": ["decoded_bytes_sha256", "text_sha256"]}}]
    },
    "scriptAnalysis": {
      "type": "object", "required": ["events", "functions", "network_calls", "field_writes", "attribute_changes", "conditions", "warnings"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
        "network_calls": {"type": "array", "items": {"$ref": "#/$defs/networkCall"}},
        "field_writes": {"type": "array", "items": {"$ref": "#/$defs/fieldWrite"}},
        "attribute_changes": {"type": "array", "items": {"$ref": "#/$defs/attributeChange"}},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/scriptWarning"}}
      }
    },
    "event": {
      "type": "object", "required": ["method", "operation", "operations", "line", "snippet", "calls", "reachable_endpoints", "endpoint_paths"],
      "properties": {
        "method": {"$ref": "#/$defs/text"}, "operation": {"$ref": "#/$defs/text"}, "operations": {"$ref": "#/$defs/strings"},
        "line": {"$ref": "#/$defs/line"}, "snippet": {"$ref": "#/$defs/text"}, "calls": {"$ref": "#/$defs/strings"},
        "reachable_endpoints": {"$ref": "#/$defs/strings"}, "endpoint_paths": {"type": "array", "items": {"$ref": "#/$defs/endpointPath"}}
      }
    },
    "endpointPath": {"type": "object", "required": ["url", "line", "path"], "properties": {"url": {"$ref": "#/$defs/text"}, "line": {"$ref": "#/$defs/line"}, "path": {"$ref": "#/$defs/strings"}}},
    "function": {"type": "object", "required": ["name", "line", "calls"], "properties": {"name": {"$ref": "#/$defs/text"}, "line": {"$ref": "#/$defs/line"}, "calls": {"$ref": "#/$defs/strings"}}},
    "networkCall": {
      "type": "object", "required": ["url", "expression", "line", "function", "snippet"],
      "properties": {"url": {"$ref": "#/$defs/nullableText", "description": "null denotes an unresolved dynamic URL."}, "expression": {"$ref": "#/$defs/text"}, "line": {"$ref": "#/$defs/line"}, "function": {"$ref": "#/$defs/nullableText"}, "snippet": {"$ref": "#/$defs/text"}}
    },
    "fieldChange": {"type": "object", "required": ["target", "line", "snippet", "function"], "properties": {"target": {"$ref": "#/$defs/text"}, "line": {"$ref": "#/$defs/line"}, "snippet": {"$ref": "#/$defs/text"}, "function": {"$ref": "#/$defs/nullableText"}}},
    "fieldWrite": {"allOf": [{"$ref": "#/$defs/fieldChange"}], "type": "object", "required": ["value"], "properties": {"value": {"$ref": "#/$defs/text"}}},
    "attributeChange": {"allOf": [{"$ref": "#/$defs/fieldChange"}], "type": "object", "required": ["attribute"], "properties": {"attribute": {"$ref": "#/$defs/text"}}},
    "condition": {"type": "object", "required": ["kind", "text", "line", "snippet"], "properties": {"kind": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/text"}, "line": {"$ref": "#/$defs/line"}, "snippet": {"$ref": "#/$defs/text"}}},
    "scriptWarning": {"type": "object", "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/nonemptyText"}, "message": {"$ref": "#/$defs/nonemptyText"}, "line": {"$ref": "#/$defs/line"}}},
    "gap": {
      "type": "object", "required": ["id", "code", "category", "severity", "scope", "title", "reason", "needed", "how_to_collect", "source_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^gap[0-9]{4,}$"}, "code": {"$ref": "#/$defs/nonemptyText"},
